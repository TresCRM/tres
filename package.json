{
  "name": "tres-crm",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "private": true,
  "scripts": {
    "approve": "pnpm approve-builds",
    "dev:web": "pnpm -C apps/web dev",
    "build:web": "pnpm -C apps/web build",
    "lint:web": "pnpm -C apps/web lint",
    "approve:builds": "pnpm approve-builds",
    "dev:api": "nodemon -w apps/api/src -e ts,json -x \"ts-node apps/api/src/server.ts\"",
    "dev:api:alt": "bash -lc 'source .env && nodemon --config apps/api/nodemon.json'",
    "dev:all": "concurrently -n web,api \"pnpm dev:web\" \"pnpm dev:api\"",
    "seed:local": "ts-node apps/api/src/utils/seed.ts",
    "seed:demo": "ts-node apps/api/src/utils/seed-demo.ts",
    "seed:templates": "pnpm ts-node apps/api/src/utils/seed-survey-template.ts",
    "logs:reindex": "ts-node apps/api/src/utils/migrations/reindex-logs.ts",
    "logs:clean": "node apps/api/scripts/cleanup-logs.js",
    "docker:start": "docker compose up -d",
    "ubuntu:start": "wsl.exe -d Ubuntu",
    "db:test:clean": "node apps/api/scripts/cleanup-test-dbs.js",
    "test:clean": "pnpm dlx jest --clearCache",
    "test:clean:run": "pnpm logs:clean && pnpm db:test:clean && pnpm test:clean && pnpm test",
    "test": "cross-env EMAILS_DISABLED=1 DISABLE_RATE_LIMIT=1 jest --passWithNoTests",
    "test:e2e": "cross-env EMAILS_DISABLED=1 DISABLE_RATE_LIMIT=1 jest --runInBand --testPathPatterns \"apps/api/src/routes/tests/.*\\.e2e\\.test\\.ts$\"",
    "test:int": "cross-env EMAILS_DISABLED=1 DISABLE_RATE_LIMIT=1 jest --runInBand --testPathPattern=\\.int\\.test\\.ts$",
    "test:unit": "cross-env EMAILS_DISABLED=1 DISABLE_RATE_LIMIT=1 jest --testPathPattern=unit\\.test\\.ts$",
    "test:mem": "cross-env EMAILS_DISABLED=1 DISABLE_RATE_LIMIT=1 USE_MEMORY_MONGO=1 jest --runInBand",
    "coverage": "cross-env EMAILS_DISABLED=1 DISABLE_RATE_LIMIT=1 jest --coverage --coverageReporters=text-summary,lcov",
    "test:cov": "cross-env EMAILS_DISABLED=1 DISABLE_RATE_LIMIT=1 jest --coverage",
    "coverage:open": "start \"\" coverage/lcov-report/index.html",
    "audit:security": "pnpm audit --prod --audit-level=high",
    "audit:full": "pnpm audit",
    "lint": "pnpm --filter web lint",
    "typecheck": "pnpm --filter web typecheck && tsc -p apps/api/tsconfig.json --noEmit && tsc -p apps/workers/tsconfig.json --noEmit",
    "docs:gen": "ts-node apps/api/src/docs/generate.ts",
    "docs:types": "openapi-typescript apps/api/openapi.json -o packages/types/src/openapi.ts",
    "dev:workers": "nodemon -w apps/workers/src -e ts,json -x \"ts-node apps/workers/src/index.ts\"",
    "build:workers": "tsc -p apps/workers/tsconfig.json",
    "start:workers": "node apps/workers/dist/index.js",
    "migrate:fix-ticket-index": "ts-node apps/api/src/utils/migrations/fix-ticket-requestId-index.ts",
    "test:email": "ts-node apps/api/src/scripts/test-email.ts",
    "test:email:trescrm": "cross-env SMTP_PROVIDER=trescrm ts-node apps/api/src/scripts/test-email.ts",
    "worker:billing": "pnpm exec ts-node -r dotenv/config apps/api/src/workers/billing.worker.ts",
    "worker:billing:fail": "cross-env BILLING_FORCE_FAIL=1 pnpm exec ts-node -r dotenv/config apps/api/src/workers/billing.worker.ts",
    "prebuild": "pnpm docs:gen",
    "project:clean": "pnpm dlx rimraf node_modules && pnpm install --force",
    "test:widget:e2e": "playwright test",
    "build:widget": "pnpm --filter @tres-crm/widget build"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.17.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "@asteasolutions/zod-to-openapi": "^8.1.0",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^24.7.0",
    "@types/nodemailer": "^7.0.2",
    "@types/sanitize-html": "^2.16.1",
    "@types/supertest": "^6.0.3",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/ws": "^8.18.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.5.0",
    "jest-environment-node": "^30.2.0",
    "jsdom": "^27.0.0",
    "mongodb-memory-server": "^10.2.3",
    "nodemon": "^3.1.10",
    "openapi-typescript": "^7.9.1",
    "supertest": "^7.1.4",
    "swagger-ui-express": "^5.0.1",
    "ts-jest": "^29.4.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.72.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.214.0",
    "@opentelemetry/resources": "^2.6.1",
    "@opentelemetry/sdk-node": "^0.214.0",
    "@opentelemetry/semantic-conventions": "^1.40.0",
    "@sentry/node": "^10.47.0",
    "@tanstack/react-query": "^5.90.3",
    "@tiptap/extension-code-block-lowlight": "^3.7.0",
    "@tiptap/react": "^3.7.0",
    "@tiptap/starter-kit": "^3.7.0",
    "@types/qrcode": "^1.5.6",
    "@types/swagger-ui-react": "^5.18.0",
    "amqplib": "^0.10.9",
    "argon2": "^0.44.0",
    "axios": "^1.12.2",
    "bcryptjs": "^3.0.2",
    "clsx": "^2.1.1",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "formik": "^2.4.6",
    "helmet": "^8.1.0",
    "highlight.js": "^11.11.1",
    "jose": "^6.1.0",
    "jsonwebtoken": "^9.0.2",
    "lowlight": "^3.3.0",
    "lucide-react": "^0.545.0",
    "mongodb": "^6.20.0",
    "mongoose": "^8.19.1",
    "multer": "^2.1.1",
    "nats": "^2.29.3",
    "next-themes": "^0.4.6",
    "nodemailer": "^7.0.9",
    "pino": "^10.0.0",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.1",
    "qrcode": "^1.5.4",
    "rate-limit-mongo": "^2.3.2",
    "react-hook-form": "^7.65.0",
    "react-syntax-highlighter": "^15.6.6",
    "sanitize-html": "^2.17.2",
    "swagger-ui-react": "^5.29.4",
    "ws": "^8.18.3",
    "zod": "^4.1.12",
    "zustand": "^5.0.8"
  },
  "pnpm": {
    "overrides": {
      "fast-xml-parser": "^5.11.0",
      "handlebars": "^4.7.9",
      "protobufjs": "^7.5.5",
      "shell-quote": "^1.10.0",
      "tar": "^7.5.22",
      "jws": "^3.2.3"
    }
  }
}
