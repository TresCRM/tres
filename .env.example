# ============================================================================
# TRES CRM - Environment Variables
# ============================================================================
# Copy this file to .env and fill in the values.
#   cp .env.example .env
#
# Variables marked [REQUIRED] have no safe default and must be set.
# Variables marked [SECRET]  must be strong random values in production.
# All others have sensible defaults shown here.
# ============================================================================

# ---------------------------------------------------------------------------
# General
# ---------------------------------------------------------------------------

# Application environment: "development" | "test" | "production"
NODE_ENV="development"

# Port the API server listens on
PORT=4000

# Public URL of the API (used in emails, links, etc.)
APP_HOST="http://localhost:4000"

# Public URL of the frontend app
FRONTEND_ORIGIN="http://localhost:3000"

# Log level: "fatal" | "error" | "warn" | "info" | "debug" | "trace"
LOG_LEVEL="info"

# ---------------------------------------------------------------------------
# Database  [REQUIRED]
# ---------------------------------------------------------------------------

# MongoDB connection string
MONGO_URI="mongodb://localhost:27017/trescrm"

# ---------------------------------------------------------------------------
# JWT / Authentication  [SECRET]
# ---------------------------------------------------------------------------

# Legacy JWT secret (used for general-purpose tokens)
JWT_SECRET="change-me-to-random-secret"

# Access-token signing secret
JWT_ACCESS_SECRET="change-me-to-random-access-secret"

# Refresh-token signing secret
JWT_REFRESH_SECRET="change-me-to-random-refresh-secret"

# Access token lifetime in seconds (default: 900 = 15 minutes)
ACCESS_TOKEN_TTL_SECONDS=900

# Refresh token lifetime in seconds (default: 1209600 = 14 days)
REFRESH_TOKEN_TTL_SECONDS=1209600

# ---------------------------------------------------------------------------
# Cookies
# ---------------------------------------------------------------------------

# Domain for auth cookies (omit or leave empty for localhost dev)
# In production set to your root domain, e.g. ".trescrm.com"
COOKIE_DOMAIN="localhost"

# Set to "true" in production (requires HTTPS)
COOKIE_SECURE="false"

# SameSite policy: "lax" | "strict" | "none"
COOKIE_SAMESITE="Lax"

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------

# Comma-separated list of allowed origins
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:4000"

# ---------------------------------------------------------------------------
# SMTP / Email
# ---------------------------------------------------------------------------

# Primary SMTP settings (take precedence over SMTP_DEFAULT_* variants)
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_SECURE=0

# SMTP credentials (leave empty for local Mailhog / Mailpit)
SMTP_USER=""
SMTP_PASS=""

# Fallback SMTP settings (used when SMTP_HOST/PORT/SECURE are not set)
SMTP_DEFAULT_HOST="localhost"
SMTP_DEFAULT_PORT=1025
SMTP_DEFAULT_SECURE=false

# Sender address shown in outgoing emails
FROM_EMAIL="TRES CRM <no-reply@trescrm.local>"

# Set to 1 to disable all outgoing emails (useful in tests)
EMAILS_DISABLED=0

# Domain used for system-generated email addresses
EMAIL_FROM_DOMAIN="trescrm.local"

# ---------------------------------------------------------------------------
# NATS / Event Bus
# ---------------------------------------------------------------------------

# NATS server URL (leave empty to disable event publishing)
EVENTS_URL="nats://localhost:4222"

# ---------------------------------------------------------------------------
# Activity & Error Logging
# ---------------------------------------------------------------------------

# Enable HTTP activity logging (1 = on, 0 = off)
ACTIVITY_LOG_ENABLED=1

# Include request body in activity logs (1 = on, 0 = off)
ACTIVITY_LOG_BODY=0

# Auto-delete activity logs older than N days
ACTIVITY_LOG_TTL_DAYS=30

# Auto-delete error logs older than N days
ERROR_LOG_TTL_DAYS=60

# ---------------------------------------------------------------------------
# Surveys  [SECRET]
# ---------------------------------------------------------------------------

# Secret for signing survey invitation tokens
SURVEY_JWT_SECRET="change-me-to-random-survey-secret"

# How many days a survey link stays valid
SURVEY_TOKEN_TTL_DAYS=14

# Default email subject for survey invitations
SURVEY_DEFAULT_SUBJECT="How did we do?"

# Default email template key for survey invitations
SURVEY_DEFAULT_TEMPLATE_KEY="survey.ticket_closed"

# ---------------------------------------------------------------------------
# Billing / Subscriptions
# ---------------------------------------------------------------------------

# Grace period (days) after failed payment before account suspension
GRACE_DAYS=7

# Billing provider: "manual" (MVP simulation) | future: "stripe", etc.
BILLING_PROVIDER="manual"

# Sender address for billing-related emails
BILLING_FROM_EMAIL="billing@trescrm.local"

# Email template keys for billing notifications
BILLING_TEMPLATE_T7="billing_t7"
BILLING_TEMPLATE_T3="billing_t3"
BILLING_TEMPLATE_T1="billing_t1"
BILLING_TEMPLATE_FAILED="billing_failed"
BILLING_TEMPLATE_EXPIRED="billing_expired"

# ---------------------------------------------------------------------------
# Rate Limiting
# ---------------------------------------------------------------------------

# Sliding window duration in milliseconds (default: 60000 = 1 minute)
RATE_LIMIT_WINDOW_MS=60000

# Max requests per window for general endpoints
RATE_LIMIT_MAX=120

# Max requests per window for auth endpoints (login, register, etc.)
AUTH_RATE_LIMIT_MAX=10

# Set to 1 to disable rate limiting entirely (NOT for production)
DISABLE_RATE_LIMIT=0

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------

# Lock account after N consecutive failed login attempts
ACCOUNT_LOCKOUT_ATTEMPTS=10

# Lockout duration in minutes
ACCOUNT_LOCKOUT_MINUTES=30

# Minimum password length enforced at registration / password change
PASSWORD_MIN_LENGTH=8
