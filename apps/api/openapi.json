{
  "openapi": "3.0.0",
  "info": {
    "title": "TRES CRM API",
    "version": "1.0.0"
  },
  "components": {
    "schemas": {},
    "parameters": {}
  },
  "paths": {
    "/api/v1/subscriptions": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "planCode": {
                    "type": "string"
                  }
                },
                "required": [
                  "planCode"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Subscribed"
          }
        }
      }
    },
    "/api/v1/tickets": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "subject": {
                    "type": "string",
                    "minLength": 3
                  },
                  "body": {
                    "type": "string",
                    "minLength": 1
                  },
                  "priority": {
                    "type": "string",
                    "enum": [
                      "LOW",
                      "MEDIUM",
                      "HIGH"
                    ]
                  },
                  "customerEmail": {
                    "type": "string",
                    "format": "email"
                  },
                  "tags": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "required": [
                  "subject",
                  "body"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Ticket created"
          }
        }
      }
    }
  }
}